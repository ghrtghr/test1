const all=series.flatMap(s=>s.v),mx=Math.max(1,...all,0),mi=Math.min(0,...all),p=50,r=mx-mi||1,Y=v=>H-p-(v-mi)/r*(H-2*p);const cs=getComputedStyle(document.body);x.fillStyle=cs.color;x.strokeStyle='#8a99ab55';
